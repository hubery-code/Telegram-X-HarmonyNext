export function encodeTdError(value: TdError): Record<string, TdJsonRaw> {
  switch (value.type) {
    case 'error':
      return encodeErrorValue(value as ErrorValue);
    default:
      return encodeUnknownObject(value as TdUnknownObject);
  }
}

